import { CmsConfig, SapphireModuleClass, ContentSchema, PipelineSchema, ShaperSchema, LoadedPreset, StaticBootstrapLayer } from '@sapphire-cms/core';

// Render static imports of CMS modules
<% Object.entries(it.modules).forEach(function ([moduleName, modulePath]) { %>
import <%= moduleName %> from '<%= modulePath %>';
<% }) %>

// Render loaded CMS config
const cmsConfig: CmsConfig = <%~ JSON.stringify(it.cmsConfig) %> as unknown as CmsConfig;

// Render loaded content schemas
<% Object.entries(it.contentSchemas).forEach(function ([schemaName, schema]) { %>
const <%= schemaName %>: ContentSchema = <%~ JSON.stringify(schema) %> as unknown as ContentSchema;
<% }) %>

// Render loaded pipeline schemas
<% Object.entries(it.pipelineSchemas).forEach(function ([schemaName, schema]) { %>
const <%= schemaName %>: PipelineSchema = <%~ JSON.stringify(schema) %> as unknown as PipelineSchema;
<% }) %>

// Render loaded document shapers schemas
<% Object.entries(it.shaperSchemas).forEach(function ([schemaName, schema]) { %>
const <%= schemaName %>: ShaperSchema = <%~ JSON.stringify(schema) %> as unknown as ShaperSchema;
<% }) %>

// Render loader presets
<% Object.entries(it.presets).forEach(function ([presetName, preset]) { %>
const <%= presetName %>: LoadedPreset = <%~ JSON.stringify(preset) %> as unknown as LoadedPreset;
<% }) %>

const modules: SapphireModuleClass[] = [ <%= Object.keys(it.modules).join(', ') %> ];
const contentSchemas: ContentSchema[] = [ <%= Object.keys(it.contentSchemas).join(', ') %> ];
const pipelines: PipelineSchema[] = [ <%= Object.keys(it.pipelineSchemas).join(', ') %> ];
const shapers: ShaperSchema[] = [ <%= Object.keys(it.shaperSchemas).join(', ') %> ];
const presets: LoadedPreset[] = [ <%= Object.keys(it.presets).join(', ') %> ];

export const staticBootstrap = new StaticBootstrapLayer(
  cmsConfig,
  modules,
  contentSchemas,
  pipelines,
  shapers,
  [],
  presets,
);
